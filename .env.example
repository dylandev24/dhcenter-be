# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database — bắt buộc
# Local (cần Docker hoặc cài PostgreSQL): postgresql://dhcenter:dhcenter@localhost:5432/dhcenter?schema=public
# Không Docker: dùng Neon/Supabase free → dán connection string vào đây
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Redis — tùy chọn (bỏ trống = cache trong RAM)
# REDIS_URL=redis://localhost:6379

# Cloudinary — tùy chọn (chỉ cần khi upload ảnh trong admin)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=dhcenter

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Admin seed (used by prisma db seed)
ADMIN_EMAIL=admin@dhcenter.com
ADMIN_PASSWORD=admin123456
ADMIN_NAME=Admin
